# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Required for /api/leads/inbound (the Mailgun webhook) — it writes with
# the service role key since Mailgun isn't a logged-in dashboard user.
# Settings > API in your Supabase project.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Resend — used by /api/leads/reply to send dashboard replies as real emails.
# Get an API key at https://resend.com/api-keys after verifying your domain.
RESEND_API_KEY=your-resend-api-key-here
RESEND_FROM_EMAIL=info@panelopia.com

# Inbound replies — see the Mailgun setup steps for how reply.panelopia.com
# gets added as a Mailgun receiving domain (does NOT touch your real info@
# mailbox — it's a separate subdomain).
REPLY_DOMAIN=reply.panelopia.com
# Mailgun -> Sending -> Webhooks -> "HTTP webhook signing key"
MAILGUN_SIGNING_KEY=your-mailgun-http-webhook-signing-key-here

# Where a customer's reply gets a "heads up" notification sent (NOT the raw
# email — see /api/leads/inbound). Defaults to RESEND_FROM_EMAIL if unset.
NOTIFY_EMAIL=info@panelopia.com
# Used to build the "view and reply in the dashboard" link in that
# notification email.
NEXT_PUBLIC_SITE_URL=https://panelopia.com
